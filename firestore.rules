rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mishbahgamingofficial@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints (Synced verbatim with firebase-blueprint.json)
    function isValidUidSubmission(data) {
      return data.keys().hasAll(['uid', 'accountName', 'status', 'ownerId', 'reviewNote', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'accountName', 'status', 'ownerId', 'reviewNote', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 6
        && data.uid.size() <= 24
        && data.uid.matches('^[A-Za-z0-9\\-_]+$')
        && data.accountName is string
        && data.accountName.size() >= 0
        && data.accountName.size() <= 80
        && data.status is string
        && data.status.size() <= 16
        && (data.status == 'pending' || data.status == 'verified' || data.status == 'rejected')
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.reviewNote is string
        && data.reviewNote.size() >= 0
        && data.reviewNote.size() <= 240
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 120
        && data.createdAt is timestamp;
    }

    // 4. Collection Rules: /uid_submissions/{submissionId}
    match /uid_submissions/{submissionId} {
      allow get: if isSignedIn()
        && isValidId(submissionId)
        && (existing().ownerId == request.auth.uid || isAdmin());

      allow list: if isSignedIn()
        && (existing().ownerId == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && isValidId(submissionId)
        && isValidUidSubmission(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (incoming().status == 'pending' && incoming().reviewNote == '') ||
          isAdmin()
        );

      allow update: if isSignedIn()
        && isValidId(submissionId)
        && isValidUidSubmission(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Owner edits their own pending submission before terminal verification
          (
            existing().ownerId == request.auth.uid
            && existing().status == 'pending'
            && incoming().status == 'pending'
            && incoming().reviewNote == existing().reviewNote
            && incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'accountName', 'updatedAt'])
          ) ||
          // Action 2: Admin verifies, rejects, or updates submission details
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewNote', 'uid', 'accountName', 'updatedAt'])
          )
        );

      allow delete: if isSignedIn()
        && isValidId(submissionId)
        && isAdmin();
    }

    // 5. Collection Rules: /admins/{adminUid}
    match /admins/{adminUid} {
      allow get: if isSignedIn()
        && isValidId(adminUid)
        && (request.auth.uid == adminUid || isAdmin());

      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(adminUid)
        && isValidAdminRecord(incoming())
        && incoming().uid == adminUid
        && incoming().createdAt == request.time
        && isAdmin();

      allow update: if false;

      allow delete: if isSignedIn()
        && isValidId(adminUid)
        && isAdmin();
    }
  }
}
